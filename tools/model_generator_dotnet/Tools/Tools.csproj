<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
	  <EmbeddedResource Include="ICDFiles\*.cid" CopyToOutputDirectory="PreserveNewest" />
	  <EmbeddedResource Include="ICDFiles\*.icd" CopyToOutputDirectory="PreserveNewest" />
	  <EmbeddedResource Include="ICDFiles\*.scd" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DynamicModelGenerator\DynamicModelGenerator.csproj" />
    <ProjectReference Include="..\StaticModelGenerator\StaticModelGenerator.csproj" />
  </ItemGroup>

</Project>
